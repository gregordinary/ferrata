[statement]
An installed package is upgraded where it stands in the way: `foo` needs
`lib>=2`, and the installed `app` 1.0 needs `lib<2`, so `app` is upgraded to
2.0, which needs `lib>=2`, with `lib`.

[repository]
P:app
V:1.0-r0
D:lib<2

P:app
V:2.0-r0
D:lib>=2

P:lib
V:1.0-r0

P:lib
V:2.0-r0

P:foo
V:1.0-r0
D:lib>=2

[installed]
P:lib
V:1.0-r0

P:app
V:1.0-r0
D:lib<2

[world]
app

[request]
foo

[answer apk-tools 3.0.9-r0]
upgrade lib 1.0-r0 2.0-r0
upgrade app 1.0-r0 2.0-r0
install foo 1.0-r0
