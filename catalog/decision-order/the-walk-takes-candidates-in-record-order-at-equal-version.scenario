V:1
D:v

P:pz
V:1
p:v
k:10
D:q1 q2

P:pa
V:1
p:v
k:10
D:q2 q1

P:c1
V:1
p:q1
k:100

P:c2
V:1
p:q1 q2=1
k:10


[request]
app

[answer apk-tools 3.0.9-r0]
install c1 1
install c2 1
